# Lablab.ai Hackathon Configuration: amd-lablab-ai-academy-challenge
PORT=3000
NODE_ENV=development

# AMD ROCm / vLLM Endpoint Configuration
ROCM_VLLM_BASE_URL=http://localhost:8000/v1
ROCM_VLLM_API_KEY=dummy-token-for-local-vllm

# Dual-Process Models
# System 1: Ultra-fast reflexive draft model running on AMD Instinct / ROCm
SYSTEM1_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
SYSTEM1_MAX_TOKENS=256
SYSTEM1_TEMPERATURE=0.2

# System 2: Deliberate reasoning & divergence recovery model
SYSTEM2_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
SYSTEM2_MAX_TOKENS=1024
SYSTEM2_TEMPERATURE=0.6

# Speculative Execution Settings
SPECULATIVE_ENABLED=true
SPECULATIVE_LOOKAHEAD_STEPS=2
SIMULATION_MODE=true # Set to false when connected to a live AMD ROCm vLLM cluster

# IP address of the ONT web management interface
ONT_IP=192.168.100.1

# Credentials for the ONT web UI (preferably TelecomAdmin/SuperAdmin if available)
ONT_USER=admin
ONT_PASS=admin

# Driver options: generic_http, huawei, zte, telnet
ONT_DRIVER=generic_http

# Comma-separated list of reliable public hosts to ping
PING_TARGETS=1.1.1.1,8.8.8.8

# Seconds between connectivity checks
CHECK_INTERVAL_SEC=10

# Number of failed checks before triggering ONT remediation
FAIL_THRESHOLD=3

# Seconds to wait after changing mode to let ONT reboot/apply
COOLDOWN_SEC=45

# Set to true to test connectivity without modifying the ONT
DRY_RUN=false

# Optional overrides for generic_http driver:
# CUSTOM_LOGIN_URL=http://192.168.1.1/api/login
# CUSTOM_WAN_URL=http://192.168.1.1/api/wan
# CUSTOM_PAYLOAD_JSON={"Mode":"Bridge","ConnectionType":"IP_Bridged"}

# Public URL of the core app (no trailing slash)
BASE_URL=https://win.ai.id
# Share the session with zh.win.ai.id (leave empty for localhost dev)
COOKIE_DOMAIN=.win.ai.id
# Comma-separated; empty = anyone can sign in. Keep it to yourself for now.
ALLOWED_EMAILS=you@example.com

# Coach (any OpenAI-compatible endpoint). Leave empty for rule-based suggestions.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_BUDGET_USD=5
# USD per 1M tokens, used for the budget cap. Set to your model's pricing.
LLM_IN_PRICE_PER_MTOK=0.30
LLM_OUT_PRICE_PER_MTOK=2.50

CLOUDFLARE_TUNNEL_TOKEN=

LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
